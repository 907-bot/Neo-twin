      "metadata": {},
      "source": ["# NeoTwin: 01 - COLMAP Pose Estimation\n", "\n", "Run this notebook on Google Colab with T4 GPU to compute camera poses from images."]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": ["# Install COLMAP\n", "!apt-get update\n", "!apt-get install -y colmap\n", "!pip install pycolmap"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": ["# Load dataset from Hugging Face\n", "from datasets import load_dataset\n", "import os\n", "\n", "os.makedirs('data/images', exist_ok=True)\n", "ds = load_dataset('jxuhf/nerf-gs-datasets', split='train')\n", "print(f'Loaded {len(ds)} scenes')"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": ["# Run COLMAP\n", "import pycolmap\n", "\n", "reconstruction = pycolmap.incremental_mapper(\n", 'data/images',\n", 'data/sparse',\n", options=pycolmap.IncrementalPipelineOptions()\n", ")\n", "print(f'Reconstruction complete: {len(reconstruction)} cameras')"]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": ["# Download sparse output\n", "import shutil\n", "shutil.make_archive('sparse_output', 'zip', 'data/sparse')\n", "from google.colab import files\n", "files.download('sparse_output.zip')"]
    }
  ],
